# Copy to .env and set values (or export in shell)

# Excel
EXCEL_PATH=Marathi to English data for LLM.xlsx
EXCEL_SHEET=0

# Use SQLite instead of MSSQL (no server needed; use on Mac when SQL Server isn't running)
USE_SQLITE=1
SQLITE_PATH=marathi_english.db

# MSSQL (local or cloud) – only when USE_SQLITE is not set (pymssql only)
MSSQL_SERVER=localhost
MSSQL_DATABASE=marathi_english
MSSQL_UID=
MSSQL_PWD=

# Table name
TRANSLATION_TABLE=marathi_english_pairs

# Rows per insert batch (0 = one bulk insert; 5000 = commit every 5000 rows)
INSERT_BATCH_SIZE=5000

# CSV translation (translate_csv.py)
# INPUT_CSV=input.csv
# OUTPUT_CSV=output.csv
# MARATHI_COLUMN=marathi_text
# OUTPUT_COLUMN=english_text
# TRANSLATE_BATCH_SIZE=16
